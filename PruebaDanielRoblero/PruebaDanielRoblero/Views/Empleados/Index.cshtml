@model List<Empleado>
@{
    ViewData["Title"] = "Empleados";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="mb-1">Empleados</h1><p class="text-secondary mb-0">Administra los empleados de la empresa.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo empleado</a>
</div>
<div class="card overflow-hidden">
    <div class="card-header bg-white py-3 px-4">Registros <span class="badge text-bg-light border ms-2">@Model.Count</span></div>
    @if (Model.Count == 0)
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay empleados</h2>
            <p class="text-secondary">Crea el primer empleado para comenzar.</p>
            <a asp-action="Create" class="btn btn-outline-primary">Crear empleado</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <caption class="visually-hidden">Listado de empleados</caption>
                <thead><tr>
                    <th scope="col">Código</th>
                    <th scope="col">Nombres</th>
                    <th scope="col">Apellidos</th>
                    <th scope="col">Fecha de nacimiento</th>
                    <th scope="col">Departamento</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr></thead>
                <tbody>
                    @foreach (var registro in Model)
                    {
                        <tr>
                            <td class="text-content">@registro.Codigo</td>
                            <td class="text-content">@registro.Nombres</td>
                            <td class="text-content">@registro.Apellidos</td>
                            <td class="text-content">@(registro.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-content">@registro.Departamento?.Nombre</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@registro.Id" class="btn btn-sm btn-outline-primary" aria-label="Editar @registro.Codigo">Editar</a>
                                <a asp-action="Delete" asp-route-id="@registro.Id" class="btn btn-sm btn-outline-danger ms-1" aria-label="Eliminar @registro.Codigo">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
